{
  "name": "humans-threejs",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Low-poly instanced humans with procedural appearance and actions for Three.js",
  "exports": {
    ".": "./create-humans.js",
    "./human-parts": "./human-parts.js",
    "./human-parts.js": "./human-parts.js"
  },
  "files": [
    "create-humans.js",
    "human-male.glb",
    "human-female.glb",
    "human-parts.js"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "preview": "python3 -m http.server 8080 --bind 127.0.0.1",
    "test:rig": "node --test tests/rig-parts.test.js",
    "generate": "python3 scripts/generate-parts.py"
  },
  "peerDependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "three": "0.180.0"
  }
}
